class dtype(enum.Enum):
    int = 1

    float32 = 2

    float64 = 3

    rng = 4

    int64 = 5

int: dtype = dtype.int

float32: dtype = dtype.float32

float64: dtype = dtype.float64

rng: dtype = dtype.rng

int64: dtype = dtype.int64

class host(enum.Enum):
    cpu = 0

    gpu = 1

cpu: host = host.cpu

gpu: host = host.gpu
