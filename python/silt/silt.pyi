"""silt python bindings"""

from collections.abc import Iterator, List, Sequence
import enum
from typing import overload


class shape:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, arg: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, arg2: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, arg2: int, arg3: int, /) -> None: ...

    @property
    def dim(self) -> int: ...

    @property
    def elem(self) -> int: ...

    @property
    def ext(self) -> List[int]: ...

    def __getitem__(self, arg: int, /) -> int: ...

    def reshape(self, d0: int = 1, d1: int = 1, d2: int = 1, d3: int = 1) -> shape: ...

    def __repr__(self) -> str: ...

    def __eq__(self, arg: object, /) -> bool: ...

class slice:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, arg: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, arg2: int, /) -> None: ...

    @overload
    def __init__(self, arg0: int, arg1: int, arg2: int, arg3: int, /) -> None: ...

    @property
    def dim(self) -> int: ...

    @property
    def shape(self) -> shape: ...

    @property
    def maxelem(self) -> int: ...

    @property
    def elem(self) -> int: ...

    @property
    def offset(self) -> List[int]: ...

    @property
    def stride(self) -> List[int]: ...

    @property
    def extent(self) -> List[int]: ...

    def reset(self) -> None: ...

    def index(self, arg0: int, arg1: int, arg2: int, arg3: int, /) -> None: ...

    def transform(self, arg: int, /) -> int: ...

    def __repr__(self) -> str: ...

class tensor:
    @overload
    def __init__(self) -> None: ...

    @overload
    def __init__(self, arg0: dtype, arg1: shape, /) -> None: ...

    @overload
    def __init__(self, arg0: dtype, arg1: shape, arg2: host, /) -> None: ...

    @property
    def type(self) -> dtype: ...

    @property
    def elem(self) -> int: ...

    @property
    def size(self) -> int: ...

    @property
    def nbytes(self) -> int: ...

    @property
    def host(self) -> host: ...

    @property
    def shape(self) -> shape: ...

    @property
    def dtype(self) -> dtype: ...

    @property
    def ndim(self) -> int: ...

    def __repr__(self) -> str: ...

    def __len__(self) -> int: ...

    def __iter__(self) -> Iterator: ...

    def item(self) -> object: ...

    def to(self, arg: host, /) -> tensor: ...

    def to_cpu(self) -> tensor: ...

    def to_gpu(self) -> tensor: ...

    def copy_to(self, host: host | None = None) -> tensor: ...

    def reshape(self, d0: int = 1, d1: int = 1, d2: int = 1, d3: int = 1) -> tensor: ...

    def flatten(self) -> tensor: ...

    def __getitem__(self, arg: tuple, /) -> view: ...

    def slice(self, arg: tuple, /) -> view: ...

    def numpy(self) -> object: ...

    def __array__(self, dtype: object | None = None, copy: object | None = None) -> object: ...

    @staticmethod
    def from_numpy(arg: object, /) -> tensor: ...

    def torch(self) -> object: ...

    @staticmethod
    def from_torch(arg: object, /) -> tensor: ...

class view:
    @property
    def type(self) -> dtype: ...

    @property
    def elem(self) -> int: ...

    @property
    def host(self) -> host: ...

    @property
    def slice(self) -> slice: ...

    @property
    def dtype(self) -> dtype: ...

    def __repr__(self) -> str: ...

